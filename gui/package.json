{
  "name": "sing-box-proxy-gui",
  "version": "0.1.0",
  "private": true,
  "description": "本地图形控制台：通过 SSH 管理多台服务器上的 sing-box-proxy",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "vite build",
    "app": "vite build && node server/index.mjs",
    "dev:server": "node --watch server/index.mjs --no-open --port 8787",
    "dev:web": "vite",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.7"
  }
}
